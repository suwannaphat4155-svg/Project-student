generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id        Int      @id @default(autoincrement())
  studentId String   @unique
  name      String
  gpa       Float
  image     String?
  createdAt DateTime @default(now())
}